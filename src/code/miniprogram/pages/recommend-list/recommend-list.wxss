.recommend-list-page {
  padding: 20rpx;
}
.header {
  margin-bottom: 20rpx;
}
.title {
  font-size: 32rpx;
  font-weight: bold;
}
.subtitle {
  font-size: 24rpx;
  color: #888;
}
.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-gap: 20rpx;
}
.grid-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.08);
}
.thumb {
  width: 100%;
  height: 260rpx;
}
.info { padding: 16rpx; }
.name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.meta { display: flex; justify-content: space-between; align-items: center; }
.price { font-size: 28rpx; color: #FF6B35; font-weight: bold; }
.tag { font-size: 22rpx; color: #999; }
.loading, .empty { text-align: center; color: #666; padding: 30rpx; }