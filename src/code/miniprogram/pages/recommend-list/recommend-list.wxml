<view class="recommend-list-page">
  <view class="header">
    <text class="title">为你推荐的更多好物</text>
    <text class="subtitle">基于你的兴趣、搜索与点击实时排序</text>
  </view>

  <view class="grid">
    <view class="grid-item" wx:for="{{items}}" wx:key="id" bindtap="onItemTap" data-id="{{item.id}}" data-product="{{item}}">
      <image class="thumb" src="{{item.image}}" mode="aspectFill" />
      <view class="info">
        <text class="name">{{item.name}}</text>
        <view class="meta">
          <text class="price">¥{{item.price}}</text>
          <text class="tag">{{item.tag}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">正在为你挑选更多好物…</view>
  <view wx:if="{{!loading && items.length === 0}}" class="empty">暂时没有更多推荐，请试试搜索或浏览</view>
</view>