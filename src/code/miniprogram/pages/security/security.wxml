<!--pages/security/security.wxml-->
<view class="page-container">
  <view class="menu-section">
    <view class="menu-group">
      <text class="group-title">账号安全</text>
      <view class="menu-list">
        <view class="menu-item" bindtap="onChangePhone">
          <text class="menu-text">手机号</text>
          <view class="menu-value">
            <text wx:if="{{phone}}">{{phone}}</text>
            <text wx:else class="placeholder">未绑定</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
        <view class="menu-item" bindtap="onChangeEmail">
          <text class="menu-text">邮箱</text>
          <view class="menu-value">
            <text wx:if="{{email}}">{{email}}</text>
            <text wx:else class="placeholder">未绑定</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
        <view class="menu-item" bindtap="onChangePassword">
          <text class="menu-text">登录密码</text>
          <view class="menu-value">
            <text wx:if="{{passwordSet}}" class="status-text">已设置</text>
            <text wx:else class="placeholder">未设置</text>
          </view>
          <text class="menu-arrow">></text>
        </view>
      </view>
    </view>

    <view class="menu-group">
      <text class="group-title">安全中心</text>
      <view class="menu-list">
        <view class="menu-item" bindtap="onAccountSecurity">
          <text class="menu-text">账号安全检测</text>
          <text class="menu-arrow">></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 安全提示 -->
  <view class="tips-section">
    <view class="tips-title">安全提示</view>
    <view class="tips-item">• 请定期修改密码，确保账号安全</view>
    <view class="tips-item">• 不要将密码告诉他人</view>
    <view class="tips-item">• 如发现异常，请及时联系客服</view>
  </view>
</view>

