<!--pages/forum/forum.wxml-->
<view class="page-container">
  <!-- 顶部搜索栏 -->
  <view class="forum-header">
    <view class="search-bar" bindtap="onSearchTap">
      <text class="search-icon">🔍</text>
      <text class="search-placeholder">搜索帖子...</text>
    </view>
    <view class="publish-btn" bindtap="onPublishTap">
      <text class="publish-icon">✏️</text>
      <text class="publish-text">发帖</text>
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x="true">
    <view class="category-list">
      <view 
        class="category-item {{currentCategory === item.value ? 'active' : ''}}"
        wx:for="{{categories}}"
        wx:key="value"
        bindtap="onCategoryChange"
        data-category="{{item.value}}"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 帖子列表 -->
  <scroll-view 
    class="post-list" 
    scroll-y="true"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    bindscrolltolower="onLoadMore"
  >
    <view class="post-item" wx:for="{{posts}}" wx:key="_id" bindtap="onPostTap" data-id="{{item._id}}">
      <!-- 用户信息 -->
      <view class="post-header">
        <image class="user-avatar" src="{{item.authorInfo.avatar || 'https://via.placeholder.com/80x80/cccccc/ffffff?text=U'}}" mode="aspectFill"></image>
        <view class="user-info">
          <text class="username">{{item.authorInfo.name || '匿名用户'}}</text>
          <text class="post-time">{{item.timeText}}</text>
        </view>
        <view class="category-tag">{{item.categoryText}}</view>
      </view>

      <!-- 帖子内容 -->
      <view class="post-content">
        <text class="post-title">{{item.title}}</text>
        <text class="post-text" wx:if="{{item.content}}">{{item.content}}</text>
        
        <!-- 图片 -->
        <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
          <image 
            class="post-image {{item.images.length === 1 ? 'single' : ''}}"
            wx:for="{{item.images}}"
            wx:key="index"
            wx:for-item="img"
            src="{{img}}"
            mode="aspectFill"
            bindtap="onPreviewImage"
            data-urls="{{item.images}}"
            data-current="{{img}}"
            catchtap="true"
          ></image>
        </view>
      </view>

      <!-- 帖子统计 -->
      <view class="post-footer">
        <view class="post-stat">
          <text class="stat-icon">👁️</text>
          <text class="stat-text">{{item.viewCount || 0}}</text>
        </view>
        <view class="post-stat">
          <text class="stat-icon">💬</text>
          <text class="stat-text">{{item.commentCount || 0}}</text>
        </view>
        <view class="post-stat">
          <text class="stat-icon">👍</text>
          <text class="stat-text">{{item.likeCount || 0}}</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="load-more" wx:if="{{hasMore}}">
      <text>加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && posts.length > 0}}">
      <text>没有更多了</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && posts.length === 0}}">
      <text class="empty-icon">📝</text>
      <text class="empty-text">暂无帖子</text>
      <text class="empty-tip">快来发布第一条帖子吧~</text>
    </view>
  </scroll-view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading && posts.length === 0}}">
    <view class="loading-content">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>

