<view class="messages-page">
  <view class="header">
    <text class="title">最近联系</text>
  </view>
  <scroll-view scroll-y="true" class="session-list">
    <block wx:for="{{sessions}}" wx:key="sessionKey">
      <view class="session-item" bindtap="openChat" data-userid="{{item.peerUserId}}" data-openid="{{item.peerOpenId}}" data-name="{{item.peerName}}">
        <view class="avatar-wrap">
          <image class="avatar" src="{{item.peerAvatar || 'https://via.placeholder.com/80x80/cccccc/ffffff?text=U'}}" mode="aspectFill" />
          <view class="badge" wx:if="{{item.unreadCount > 0}}">{{item.unreadCount}}</view>
        </view>
        <view class="info">
          <view class="row">
            <text class="name">{{item.peerName || '用户'}}</text>
            <text class="time">{{item.timeText}}</text>
          </view>
          <text class="preview">{{item.lastContentType === 'text' ? item.lastContent : '[图片]'}}</text>
        </view>
      </view>
    </block>
    <view class="empty" wx:if="{{!loading && sessions.length === 0}}">暂无会话</view>
  </scroll-view>
</view>