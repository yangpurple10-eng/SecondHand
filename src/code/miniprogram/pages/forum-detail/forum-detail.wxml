<!--pages/forum-detail/forum-detail.wxml-->
<view class="page-container">
  <scroll-view class="scroll-container" scroll-y="true" wx:if="{{!loading}}">
    <!-- 帖子内容 -->
    <view class="post-container">
      <!-- 用户信息 -->
      <view class="post-header">
        <image class="user-avatar" src="{{post.authorInfo.avatar || 'https://via.placeholder.com/80x80/cccccc/ffffff?text=U'}}" mode="aspectFill"></image>
        <view class="user-info">
          <text class="username">{{post.authorInfo.name || '匿名用户'}}</text>
          <text class="post-time">{{post.timeText}}</text>
        </view>
        <view class="category-tag">{{post.categoryText}}</view>
      </view>

      <!-- 帖子标题和内容 -->
      <view class="post-content">
        <text class="post-title">{{post.title}}</text>
        <text class="post-text">{{post.content}}</text>
        
        <!-- 图片 -->
        <view class="post-images" wx:if="{{post.images && post.images.length > 0}}">
          <image 
            class="post-image"
            wx:for="{{post.images}}"
            wx:key="index"
            wx:for-item="img"
            src="{{img}}"
            mode="widthFix"
            bindtap="onPreviewImage"
            data-urls="{{post.images}}"
            data-current="{{img}}"
          ></image>
        </view>
      </view>

      <!-- 帖子统计 -->
      <view class="post-stats">
        <view class="stat-item">
          <text class="stat-icon">👁️</text>
          <text class="stat-text">{{post.viewCount || 0}}</text>
        </view>
        <view class="stat-item">
          <text class="stat-icon">💬</text>
          <text class="stat-text">{{post.commentCount || 0}}</text>
        </view>
        <view class="stat-item" bindtap="onToggleLike">
          <text class="stat-icon">{{isLiked ? '❤️' : '🤍'}}</text>
          <text class="stat-text">{{post.likeCount || 0}}</text>
        </view>
      </view>
    </view>

    <!-- 评论列表 -->
    <view class="comments-section">
      <view class="section-title">
        <text>评论 ({{comments.length}})</text>
      </view>
      
      <view class="comment-item" wx:for="{{comments}}" wx:key="_id">
        <image class="comment-avatar" src="{{item.authorInfo.avatar || 'https://via.placeholder.com/80x80/cccccc/ffffff?text=U'}}" mode="aspectFill"></image>
        <view class="comment-content">
          <view class="comment-header">
            <text class="comment-author">{{item.authorInfo.name || '匿名用户'}}</text>
            <text class="comment-time">{{item.timeText}}</text>
          </view>
          <text class="comment-text">{{item.content}}</text>
        </view>
      </view>

      <view class="empty-comments" wx:if="{{comments.length === 0}}">
        <text>暂无评论，快来抢沙发吧~</text>
      </view>
    </view>
  </scroll-view>

  <!-- 评论输入框 -->
  <view class="comment-input-container">
    <view class="input-wrapper">
      <input 
        class="comment-input" 
        placeholder="写评论..." 
        value="{{inputText}}"
        bindinput="onInputChange"
        bindconfirm="onSubmitComment"
        confirm-type="send"
      />
      <view class="send-btn {{inputText.trim() ? 'active' : ''}}" bindtap="onSubmitComment">
        <text>发送</text>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <view class="loading-content">
      <text class="loading-text">加载中...</text>
    </view>
  </view>
</view>

