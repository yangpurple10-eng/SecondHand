/**app.wxss**/
/* 全局样式重置 */
page {
  height: 100%;
  background-color: #f5f5f5;
}

/* 容器样式 */
/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 


/* 通用文本样式 */
text {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', SimSun, sans-serif;
}

/* 通用按钮样式 */
button {
  border-radius: 8rpx;
  font-size: 32rpx;
}

button::after {
  border: none;
}

/* 通用输入框样式 */
input {
  font-size: 32rpx;
  color: #333;
}

/* 通用图片样式 */
image {
  display: block;
}

/* 通用滚动条样式 */
::-webkit-scrollbar {
  width: 0;
  height: 0;
  color: transparent;
}
