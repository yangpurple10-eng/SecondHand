.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: #ffffff;
  border-top: 1rpx solid #e0e0e0;
  padding: 15rpx 0;
  z-index: 1000;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
}
.tab-item.active .tab-text { color: #4f8bff; }
.tab-icon-emoji { font-size: 44rpx; margin-bottom: 8rpx; line-height: 1; }
.tab-text { font-size: 20rpx; }